#!/usr/bin/env bash
# Starts Home Row Tutor. First run creates .venv and installs the anthropic SDK
# (only needed for AI hints; without it the tutor uses its authored hints).
set -u
cd "$(dirname "$0")"
PY=python3
if [ ! -x .venv/bin/python ]; then
  python3 -m venv .venv 2>/dev/null || echo "Could not create .venv; using system python3."
fi
if [ -x .venv/bin/python ]; then
  PY=.venv/bin/python
  if ! "$PY" -c "import anthropic" 2>/dev/null; then
    echo "Installing the anthropic SDK (one time)..."
    "$PY" -m pip install --quiet --disable-pip-version-check anthropic \
      || echo "Install failed; continuing with offline hints."
  fi
fi
exec "$PY" server.py "$@"
